<?xml version="1.0"?>
<!-- OnRobot RG2 (v1), visuals and joints only, from onrobot_description's onrobot_rg.urdf.xacro and
     config/rg2_v1.yaml (libishm1/onrobot1_ros @ 9c6ce32, MIT; after ikalevatykh/onrobot_ros, MIT).
     Fingers open along x; finger_joint is finger 1's moment arm, 0 open to 1.2197 closed.

     The RG2 bolts to its own bracket at an angle. Each arm of the bracket ends in a ring of twelve
     holes, 30° apart on a 28.3 mm circle whose middle is 39 mm out from the flange; the body has M4
     holes on the corners of a 20 mm square about the same point, 11 mm behind its own origin, and
     bolts to whichever of the ring's holes those meet. So the body turns about the ring's middle, on
     the axis its fingers open along. The editor draws a tool back from its fingertips, so the body
     is the fixed part here and the bracket hangs off it on mount_joint, at the ring's middle (the
     source has it the other way round, as a fixed mount_angle about the body's origin, which is only
     right with the gripper straight). The root is where the flange is with the gripper straight. -->
<robot name="onrobot_rg2">
  <material name="onrobot/grey"><color rgba="0.65 0.62 0.58 1"/></material>
  <material name="onrobot/light_grey"><color rgba="0.9 0.92 0.93 1"/></material>
  <material name="onrobot/dark_grey"><color rgba="0.25 0.25 0.25 1"/></material>

  <link name="gripper_base"/>
  <joint name="body_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="body"/>
  </joint>
  <link name="body">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/body.stl"/></geometry>
      <material name="onrobot/light_grey"/>
    </visual>
  </link>

  <joint name="mount_joint" type="revolute">
    <origin xyz="0 0 -0.011" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="bracket"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="0.5"/>
  </joint>
  <link name="bracket">
    <visual>
      <origin xyz="0 0 -0.039" rpy="0 0 0"/>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/single_bracket.stl"/></geometry>
      <material name="onrobot/grey"/>
    </visual>
  </link>

  <!-- finger 1 -->
  <link name="finger_1_moment_arm">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/moment_arm.stl"/></geometry>
      <material name="onrobot/light_grey"/>
    </visual>
  </link>
  <joint name="finger_joint" type="revolute">
    <origin xyz="-0.017 0 0.055" rpy="0 -0.772 0"/>
    <parent link="body"/>
    <child link="finger_1_moment_arm"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.3" effort="10" velocity="0.5"/>
  </joint>
  <link name="finger_1_truss_arm">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/truss_arm.stl"/></geometry>
      <material name="onrobot/light_grey"/>
    </visual>
  </link>
  <joint name="finger_1_truss_arm_joint" type="revolute">
    <origin xyz="-0.0075 0 0.0715" rpy="0 -0.772 0"/>
    <parent link="body"/>
    <child link="finger_1_truss_arm"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.3" effort="10" velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="finger_1_finger_tip">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/finger_tip.stl"/></geometry>
      <material name="onrobot/light_grey"/>
    </visual>
  </link>
  <joint name="finger_1_finger_tip_joint" type="revolute">
    <origin xyz="-0.0256 0 0.04868" rpy="0 0.772 0"/>
    <parent link="finger_1_truss_arm"/>
    <child link="finger_1_finger_tip"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="1.3" effort="10" velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="finger_1_flex_finger">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/flex_finger.stl"/></geometry>
      <material name="onrobot/dark_grey"/>
    </visual>
  </link>
  <joint name="finger_1_flex_finger_joint" type="fixed">
    <origin xyz="0.03059 0 0.0172" rpy="0 0 0"/>
    <parent link="finger_1_finger_tip"/>
    <child link="finger_1_flex_finger"/>
  </joint>

  <!-- finger 2: the same, half a turn about the body's axis -->
  <link name="finger_2_origin"/>
  <joint name="finger_2_origin_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
    <parent link="body"/>
    <child link="finger_2_origin"/>
  </joint>
  <link name="finger_2_moment_arm">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/moment_arm.stl"/></geometry>
      <material name="onrobot/light_grey"/>
    </visual>
  </link>
  <joint name="finger_2_moment_arm_joint" type="revolute">
    <origin xyz="-0.017 0 0.055" rpy="0 -0.772 0"/>
    <parent link="finger_2_origin"/>
    <child link="finger_2_moment_arm"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.3" effort="10" velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="finger_2_truss_arm">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/truss_arm.stl"/></geometry>
      <material name="onrobot/light_grey"/>
    </visual>
  </link>
  <joint name="finger_2_truss_arm_joint" type="revolute">
    <origin xyz="-0.0075 0 0.0715" rpy="0 -0.772 0"/>
    <parent link="finger_2_origin"/>
    <child link="finger_2_truss_arm"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="1.3" effort="10" velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="finger_2_finger_tip">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/finger_tip.stl"/></geometry>
      <material name="onrobot/light_grey"/>
    </visual>
  </link>
  <joint name="finger_2_finger_tip_joint" type="revolute">
    <origin xyz="-0.0256 0 0.04868" rpy="0 0.772 0"/>
    <parent link="finger_2_truss_arm"/>
    <child link="finger_2_finger_tip"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="1.3" effort="10" velocity="0.5"/>
    <mimic joint="finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="finger_2_flex_finger">
    <visual>
      <geometry><mesh filename="package://onrobot_description/meshes/rg2_v1/visual/flex_finger.stl"/></geometry>
      <material name="onrobot/dark_grey"/>
    </visual>
  </link>
  <joint name="finger_2_flex_finger_joint" type="fixed">
    <origin xyz="0.03059 0 0.0172" rpy="0 0 0"/>
    <parent link="finger_2_finger_tip"/>
    <child link="finger_2_flex_finger"/>
  </joint>
</robot>
